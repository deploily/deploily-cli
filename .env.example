# Optional overrides. The CLI defaults to the public Deploily Keycloak instance.
# No .env file is required for normal use.

KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="deploily"
KEYCLOAK_CLIENT_ID="deploily"
KEYCLOAK_REDIRECT_URI="http://localhost:8080/callback"
KEYCLOAK_CLIENT_SECRET=""

# Advanced overrides (normally not needed)
# KEYCLOAK_REALM_URL="https://auth.deploily.cloud/realms/deploily"
# KEYCLOAK_AUTH_ENDPOINT="https://auth.deploily.cloud/realms/deploily/protocol/openid-connect/auth"
# KEYCLOAK_TOKEN_ENDPOINT="https://auth.deploily.cloud/realms/deploily/protocol/openid-connect/token"
# KEYCLOAK_LOGOUT_ENDPOINT="https://auth.deploily.cloud/realms/deploily/protocol/openid-connect/logout"
# KEYCLOAK_USERINFO_ENDPOINT="https://auth.deploily.cloud/realms/deploily/protocol/openid-connect/userinfo"